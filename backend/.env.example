# Copy this file to .env and fill in real values for local development.
# In production (Render), set these as environment variables in the dashboard instead.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of frontend origins allowed to call this API.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Leave unset locally to use SQLite. In production, set to your Postgres URL,
# e.g. postgres://user:password@host:5432/dbname
DATABASE_URL=

# Paste the full contents of your Google service-account JSON key as a single
# line here for production. Locally, you can instead just place a
# credentials.json file in this backend/ folder (already gitignored).
GOOGLE_SHEETS_CREDENTIALS_JSON=
GOOGLE_SHEET_NAME=AttendanceSystem

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
